{
  "name": "sn-management-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @sn-group/www dev",
    "dev:web": "pnpm --filter @hr-portal/web dev",
    "dev:web:e2e": "node scripts/start-playwright-web.js",
    "dev:all": "pnpm --filter @sn-group/www --filter @hr-portal/web dev",
    "dev:mobile": "pnpm --filter @hr-portal/mobile dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @hr-portal/web build",
    "build:www": "pnpm --filter @sn-group/www build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "test:e2e:local:ui": "playwright test --config playwright.local.config.ts --ui",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rimraf node_modules",
    "db:migrate": "pnpm --filter @hr-portal/database migrate",
    "db:seed": "pnpm --filter @hr-portal/database seed",
    "db:generate": "pnpm --filter @hr-portal/database generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "jsdom": "^26.0.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.14",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "next": "15.5.7",
      "@next/swc-darwin-arm64": "15.5.7",
      "@next/swc-darwin-x64": "15.5.7",
      "@next/swc-linux-arm64-gnu": "15.5.7",
      "@next/swc-linux-arm64-musl": "15.5.7",
      "@next/swc-linux-x64-gnu": "15.5.7",
      "@next/swc-linux-x64-musl": "15.5.7",
      "@next/swc-win32-arm64-msvc": "15.5.7",
      "@next/swc-win32-x64-msvc": "15.5.7"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
