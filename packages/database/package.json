{
  "name": "@hr-portal/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "generate": "supabase gen types typescript --local > src/types/database.types.ts",
    "migrate": "supabase db push",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supabase": "^1.226.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
