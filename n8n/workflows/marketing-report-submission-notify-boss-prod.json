                  {
                      "id":  "build-notification",
                      "name":  "Build Notification",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       688,
                                       304
                                   ],
                      "parameters":  {
                                         "jsCode":  "const body = $json.body;\nconst employees = Array.isArray(body) ? body : (typeof body === \u0027string\u0027 ? JSON.parse(body) : []);\nconst employee = employees[0];\nif (!employee) return [];\n\nconst todayLabel = new Date().toLocaleDateString(\u0027en-PH\u0027, { timeZone: \u0027Asia/Manila\u0027, year: \u0027numeric\u0027, month: \u0027long\u0027, day: \u0027numeric\u0027 });\n\nconst employeeName = `${employee.first_name} ${employee.last_name}`;\n\nconst text = [\n  \u0027?? \u003cb\u003eMarketing Report Submitted\u003c/b\u003e\u0027,\n  \u0027\u0027,\n  `?? \u003cb\u003eDate:\u003c/b\u003e ${todayLabel}`,\n  `?? \u003cb\u003eEmployee:\u003c/b\u003e ${employeeName}`,\n  \u0027\u0027,\n  \u0027This employee has submitted their weekly marketing report.\u0027,\n  \u0027\u0027,\n  \u0027?? \u003ca href=\"https://app.sngroup.com.au\"\u003eView in HR Portal\u003c/a\u003e\u0027\n].join(\u0027\\n\u0027);\n\nreturn [{ json: { telegramText: text } }];"
                                     }
                  },
                  {
                      "id":  "notify-boss",
                      "name":  "Notify Boss",
                      "type":  "n8n-nodes-base.telegram",
                      "typeVersion":  1.2,
                      "position":  [
                                       912,
                                       304
                                   ],
                      "parameters":  {
