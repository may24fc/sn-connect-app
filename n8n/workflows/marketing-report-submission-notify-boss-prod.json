                                         "text":  "={{ $json.telegramText }}",
                                         "resource":  "message",
                                         "operation":  "sendMessage",
                                         "additionalFields":  {
                                                                  "parse_mode":  "HTML"
                                                              }
                                     },
                      "credentials":  {
                                          "telegramApi":  {
                                                              "id":  "br7oYixc6HEh3DQc",
                                                              "name":  "SN Connect Notifications"
                                                          }
                                      }
                  }
              ],
