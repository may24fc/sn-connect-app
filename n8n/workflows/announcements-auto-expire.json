{
  "name": "Announcements Auto Expire",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "Cron_Daily",
      "name": "Daily Midnight Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 280]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.announcements SET status = 'expired' WHERE status = 'published' AND expires_at <= now() AND deleted_at IS NULL RETURNING id, title;"
      },
      "id": "Expire_Published",
      "name": "Expire Published Announcements",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [520, 280],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    }
  ],
  "connections": {
    "Daily Midnight Trigger": {
      "main": [
        [
          {
            "node": "Expire Published Announcements",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
