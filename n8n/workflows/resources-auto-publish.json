{
  "name": "Resources Auto Publish",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "Cron_Trigger",
      "name": "Cron Trigger Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 280]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, category, resource_type, published_at FROM public.resources WHERE status = 'draft' AND published_at IS NOT NULL AND published_at <= now() AND deleted_at IS NULL ORDER BY published_at ASC;"
      },
      "id": "Query_Scheduled",
      "name": "Query Scheduled Resources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 280],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "Check_Has_Results",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "Check_Results",
      "name": "Check If Resources Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 280]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.resources SET status = 'published' WHERE status = 'draft' AND published_at IS NOT NULL AND published_at <= now() AND deleted_at IS NULL RETURNING id, title, category, resource_type;"
      },
      "id": "Publish_Scheduled",
      "name": "Publish Scheduled Resources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [980, 160],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst summary = {\n  count: rows.length,\n  resources: rows.map(r => `${r.title} (${r.category} - ${r.resource_type})`).join(', ')\n};\nreturn [{ json: summary }];"
      },
      "id": "Summarize",
      "name": "Summarize Published Resources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1220, 160]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, record_id, action, changed_fields, performed_by, ip_address, user_agent, metadata) SELECT 'resources', id, 'auto_publish', jsonb_build_object('status', 'published', 'published_at', published_at), author_id, NULL, 'n8n-automation', jsonb_build_object('workflow', 'resources-auto-publish', 'triggered_at', now()) FROM public.resources WHERE id IN (SELECT unnest(ARRAY[{{ $json.resources.map(r => \"'\" + r.id + \"'\").join(',') }}]::uuid[]));"
      },
      "id": "Audit_Log",
      "name": "Create Audit Logs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1460, 160],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_URL }}/resources/published",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "resources",
              "value": "={{ $json }}"
            },
            {
              "name": "event",
              "value": "auto_published"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "Trigger_Notification",
      "name": "Trigger Notification Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 160],
      "credentials": {
        "httpHeaderAuth": {
          "id": "N8N_WEBHOOK_AUTH_ID",
          "name": "n8n Webhook Auth"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, action, performed_by, metadata) VALUES ('resources', 'auto_publish_check', NULL, jsonb_build_object('workflow', 'resources-auto-publish', 'result', 'no_resources_to_publish', 'checked_at', now()));"
      },
      "id": "Log_No_Results",
      "name": "Log No Resources To Publish",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [980, 400],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "={{ $json.message }}",
        "options": {}
      },
      "id": "Error_Handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1220, 400],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, action, metadata) VALUES ('resources', 'auto_publish_error', jsonb_build_object('workflow', 'resources-auto-publish', 'error', '{{ $json.message }}', 'error_at', now()));"
      },
      "id": "Log_Error",
      "name": "Log Error To Audit",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1460, 540],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "subject": "Resources Auto Publish - Error Alert",
        "message": "Error in resources auto-publish workflow:\n\n{{ $json.message }}\n\nTime: {{ new Date().toISOString() }}",
        "options": {}
      },
      "id": "Alert_Email",
      "name": "Send Error Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1700, 540]
    }
  ],
  "connections": {
    "Cron Trigger Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Query Scheduled Resources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Scheduled Resources": {
      "main": [
        [
          {
            "node": "Check If Resources Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Resources Found": {
      "main": [
        [
          {
            "node": "Publish Scheduled Resources",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log No Resources To Publish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish Scheduled Resources": {
      "main": [
        [
          {
            "node": "Summarize Published Resources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Published Resources": {
      "main": [
        [
          {
            "node": "Create Audit Logs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Audit Logs": {
      "main": [
        [
          {
            "node": "Trigger Notification Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log No Resources To Publish": {
      "main": [
        [
          {
            "node": "Error Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Handler": {
      "main": [
        [
          {
            "node": "Log Error To Audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error To Audit": {
      "main": [
        [
          {
            "node": "Send Error Alert Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "1",
  "meta": {
    "instanceId": "sn-hr-portal"
  },
  "tags": [
    {
      "name": "resources",
      "id": "resources-automation"
    },
    {
      "name": "scheduled",
      "id": "scheduled-tasks"
    }
  ]
}
