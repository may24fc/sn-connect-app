{
    "id":  "P6mER0zzLedoLaA6",
    "name":  "[Control Hub] [Prod] Marketing Report Submission Notif",
    "active":  false,
    "_comment":  "PRODUCTION workflow. Webhook-triggered. Fires immediately when a marketing employee submits a report. App POSTs { employee_id, submitted_at, report_display_name, is_weekly_plan } to the webhook URL. Queries prod Supabase via header-auth credential plus publishable apikey.",
    "nodes":  [
                  {
                      "id":  "webhook-trigger",
                      "name":  "Report Submitted Webhook",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  2,
                      "position":  [
                                       240,
                                       304
                                   ],
                      "parameters":  {
                                         "httpMethod":  "POST",
                                         "path":  "marketing-report-submitted-prod",
                                         "responseMode":  "onReceived",
                                         "options":  {

                                                     }
                                     }
                  },
                  {
                      "id":  "fetch-employee",
                      "name":  "Fetch Employee",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       464,
                                       304
                                   ],
                      "parameters":  {
                                         "method":  "GET",
                                         "url":  "=https://tccdupkjmwwxcvpqnpeb.supabase.co/rest/v1/employees?select=first_name,last_name\u0026id=eq.{{ $json.body.employee_id }}\u0026deleted_at=is.null\u0026limit=1",
                                         "authentication":  "genericCredentialType",
                                         "genericAuthType":  "httpHeaderAuth",
                                         "sendHeaders":  true,
                                         "headerParameters":  {
                                                                  "parameters":  [
                                                                                     {
                                                                                         "name":  "apikey",
                                                                                         "value":  "sb_publishable_fUepYGIPOBdKoODK4_LHHg_OpffHNG9"
                                                                                     },
                                                                                     {
                                                                                         "name":  "Content-Type",
                                                                                         "value":  "application/json"
                                                                                     }
                                                                                 ]
                                                              },
                                         "credentials":  {
                                                              "httpHeaderAuth":  {
                                                                                     "id":  "Qtoo65GeBSupj5X6",
                                                                                     "name":  "[Prod] Control Hub Supabase Service Role"
                                                                                 }
                                                          },
                                         "options":  {
                                                         "response":  {
                                                                          "response":  {
                                                                                           "responseFormat":  "json",
                                                                                           "fullResponse":  true
                                                                                       }
                                                                      }
                                                     }
                                     }
                  },
                  {
                      "id":  "build-notification",
                      "name":  "Build Notification",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       688,
                                       304
                                   ],
                      "parameters":  {
                                         "jsCode":  "const employeeResponse = $json.body;\nconst employees = Array.isArray(employeeResponse) ? employeeResponse : (typeof employeeResponse === \u0027string\u0027 ? JSON.parse(employeeResponse) : []);\nconst employee = employees[0];\nif (!employee) return [];\n\nconst submission = $('Report Submitted Webhook').first().json.body ?? {};\nconst submittedAtValue = typeof submission.submitted_at === \u0027string\u0027 ? submission.submitted_at : null;\nconst submittedAt = submittedAtValue ? new Date(submittedAtValue) : new Date();\nconst formattedDate = Number.isNaN(submittedAt.getTime()) ? new Date() : submittedAt;\nconst todayLabel = formattedDate.toLocaleDateString(\u0027en-PH\u0027, { timeZone: \u0027Asia/Manila\u0027, year: \u0027numeric\u0027, month: \u0027long\u0027, day: \u0027numeric\u0027 });\n\nconst rawReportDisplayName = typeof submission.report_display_name === \u0027string\u0027 ? submission.report_display_name.trim() : \u0027\u0027;\nconst reportDisplayName = rawReportDisplayName || \u0027Marketing\u0027;\nconst isWeeklyPlan = submission.is_weekly_plan === true;\nconst reportNoun = /report$/i.test(reportDisplayName) ? reportDisplayName : `${reportDisplayName} report`;\nconst header = isWeeklyPlan ? \u0027Weekly Plan Submitted\u0027 : (/report$/i.test(reportDisplayName) ? `${reportDisplayName} Submitted` : `${reportDisplayName} Report Submitted`);\nconst summary = isWeeklyPlan ? \u0027This employee has submitted their weekly plan.\u0027 : `This employee has submitted their ${reportNoun}.`;\nconst employeeName = `${employee.first_name} ${employee.last_name}`;\n\nconst text = [\n  `📨 <b>${header}</b>`,\n  \u0027\u0027,\n  `📅 <b>Date:</b> ${todayLabel}`,\n  `👤 <b>Employee:</b> ${employeeName}`,\n  \u0027\u0027,\n  summary,\n  \u0027\u0027,\n  \u0027🔗 <a href=\"https://app.sngroup.com.au\">View in HR Portal</a>\u0027\n].join(\u0027\\n\u0027);\n\nreturn [{ json: { telegramText: text } }];"
                                     }
                  },
                  {
                      "id":  "notify-boss",
                      "name":  "Notify Boss",
                      "type":  "n8n-nodes-base.telegram",
                      "typeVersion":  1.2,
                      "position":  [
                                       912,
                                       304
                                   ],
                      "parameters":  {
                                         "chatId":  "6708968435",
                                         "text":  "={{ $json.telegramText }}",
                                         "resource":  "message",
                                         "operation":  "sendMessage",
                                         "additionalFields":  {
                                                                  "parse_mode":  "HTML"
                                                              }
                                     },
                      "credentials":  {
                                          "telegramApi":  {
                                                              "id":  "br7oYixc6HEh3DQc",
                                                              "name":  "Control Hub Notifications"
                                                          }
                                      }
                  }
              ],
    "connections":  {
