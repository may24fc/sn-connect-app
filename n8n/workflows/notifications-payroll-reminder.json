{
  "name": "Notifications Payroll Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "Cron_Daily_8AM",
      "name": "Daily 8AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 280]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT i.id AS invoice_id, i.invoice_number, i.status, i.period_end, e.id AS employee_id, e.first_name, e.last_name, u.email AS employee_email FROM public.invoices i JOIN public.employees e ON e.id = i.employee_id JOIN public.users u ON u.id = e.user_id WHERE i.deleted_at IS NULL AND e.deleted_at IS NULL AND u.deleted_at IS NULL AND u.status = 'active' AND i.status IN ('draft', 'submitted') AND i.period_end = (CURRENT_DATE + INTERVAL '3 day')::date ORDER BY i.period_end ASC, e.last_name, e.first_name;"
      },
      "id": "Query_Pending_Invoices",
      "name": "Query Pending Invoices",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 280],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "Has_Pending_Invoice",
              "leftValue": "={{ $json.invoice_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "If_Invoices_Found",
      "name": "If Pending Invoices Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 280]
    },
    {
      "parameters": {
        "operation": "send",
        "email": "={{ $json.employee_email }}",
        "subject": "Payroll Reminder: Pending Invoice {{ $json.invoice_number }}",
        "emailType": "text",
        "message": "Hi {{ $json.first_name }},\n\nThis is a reminder that invoice {{ $json.invoice_number }} (status: {{ $json.status }}) is still pending.\n\nPayroll cut-off is on {{ $json.period_end }} (3 days from today). Please submit/complete the required actions before the deadline.\n\nSN Connect HR Portal",
        "options": {}
      },
      "id": "Send_Reminder_Email",
      "name": "Send Payroll Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [980, 180]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, record_id, action, metadata) VALUES ('invoices', '{{ $json.invoice_id }}', 'payroll_deadline_reminder_sent', jsonb_build_object('workflow', 'notifications-payroll-reminder', 'invoice_number', '{{ $json.invoice_number }}', 'recipient_email', '{{ $json.employee_email }}', 'deadline', '{{ $json.period_end }}', 'sent_at', now()));"
      },
      "id": "Audit_Log",
      "name": "Create Audit Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1220, 180],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, action, metadata) VALUES ('invoices', 'payroll_deadline_reminder_skipped', jsonb_build_object('workflow', 'notifications-payroll-reminder', 'reason', 'no_pending_invoices_for_deadline_window', 'checked_at', now()));"
      },
      "id": "Log_No_Pending",
      "name": "Log No Pending Invoices",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [980, 420],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    }
  ],
  "connections": {
    "Daily 8AM Trigger": {
      "main": [
        [
          {
            "node": "Query Pending Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Pending Invoices": {
      "main": [
        [
          {
            "node": "If Pending Invoices Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Pending Invoices Found": {
      "main": [
        [
          {
            "node": "Send Payroll Reminder Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log No Pending Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Payroll Reminder Email": {
      "main": [
        [
          {
            "node": "Create Audit Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}
