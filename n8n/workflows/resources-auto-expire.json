{
  "name": "Resources Auto Expire",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "Cron_Daily",
      "name": "Daily Midnight Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 280]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, category, resource_type, expires_at FROM public.resources WHERE status = 'published' AND expires_at IS NOT NULL AND expires_at <= now() AND deleted_at IS NULL ORDER BY expires_at ASC;"
      },
      "id": "Query_Expired",
      "name": "Query Expired Resources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 280],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "Check_Has_Results",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "Check_Results",
      "name": "Check If Expired Resources Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 280]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.resources SET status = 'archived' WHERE status = 'published' AND expires_at IS NOT NULL AND expires_at <= now() AND deleted_at IS NULL RETURNING id, title, category, resource_type, expires_at;"
      },
      "id": "Expire_Published",
      "name": "Archive Expired Resources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [980, 160],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst summary = {\n  count: rows.length,\n  resources: rows.map(r => ({\n    id: r.id,\n    title: r.title,\n    category: r.category,\n    resource_type: r.resource_type,\n    expired_at: r.expires_at\n  })),\n  details: rows.map(r => `${r.title} (${r.category})`).join(', ')\n};\nreturn [{ json: summary }];"
      },
      "id": "Summarize",
      "name": "Summarize Archived Resources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1220, 160]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, record_id, action, changed_fields, performed_by, ip_address, user_agent, metadata) SELECT 'resources', id, 'auto_archive', jsonb_build_object('status', 'archived', 'previous_status', 'published', 'expires_at', expires_at), author_id, NULL, 'n8n-automation', jsonb_build_object('workflow', 'resources-auto-expire', 'triggered_at', now(), 'reason', 'expiration_date_reached') FROM public.resources WHERE id IN (SELECT unnest(ARRAY[{{ $json.resources.map(r => \"'\" + r.id + \"'\").join(',') }}]::uuid[]));"
      },
      "id": "Audit_Log",
      "name": "Create Audit Logs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1460, 160],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "subject": "Resources Auto Expire Report - {{ new Date().toISOString().split('T')[0] }}",
        "message": "Archived {{ $json.count }} expired resources:\n\n{{ $json.details }}\n\nTimestamp: {{ new Date().toISOString() }}",
        "options": {}
      },
      "id": "Notify_Email",
      "name": "Send Summary Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1700, 160]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, action, performed_by, metadata) VALUES ('resources', 'auto_expire_check', NULL, jsonb_build_object('workflow', 'resources-auto-expire', 'result', 'no_expired_resources', 'checked_at', now()));"
      },
      "id": "Log_No_Results",
      "name": "Log No Expired Resources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [980, 400],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "={{ $json.message }}",
        "options": {}
      },
      "id": "Error_Handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1220, 400],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.audit_logs (table_name, action, metadata) VALUES ('resources', 'auto_expire_error', jsonb_build_object('workflow', 'resources-auto-expire', 'error', '{{ $json.message }}', 'stack', '{{ $json.stack }}', 'error_at', now()));"
      },
      "id": "Log_Error",
      "name": "Log Error To Audit",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1460, 540],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "subject": "Resources Auto Expire - Error Alert",
        "message": "Error in resources auto-expire workflow:\n\n{{ $json.message }}\n\nTime: {{ new Date().toISOString() }}\n\nPlease check the audit logs for more details.",
        "options": {}
      },
      "id": "Alert_Email",
      "name": "Send Error Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1700, 540]
    }
  ],
  "connections": {
    "Daily Midnight Trigger": {
      "main": [
        [
          {
            "node": "Query Expired Resources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Expired Resources": {
      "main": [
        [
          {
            "node": "Check If Expired Resources Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Expired Resources Found": {
      "main": [
        [
          {
            "node": "Archive Expired Resources",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log No Expired Resources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Archive Expired Resources": {
      "main": [
        [
          {
            "node": "Summarize Archived Resources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Archived Resources": {
      "main": [
        [
          {
            "node": "Create Audit Logs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Audit Logs": {
      "main": [
        [
          {
            "node": "Send Summary Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log No Expired Resources": {
      "main": [
        [
          {
            "node": "Error Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Handler": {
      "main": [
        [
          {
            "node": "Log Error To Audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error To Audit": {
      "main": [
        [
          {
            "node": "Send Error Alert Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "1",
  "meta": {
    "instanceId": "sn-hr-portal"
  },
  "tags": [
    {
      "name": "resources",
      "id": "resources-automation"
    },
    {
      "name": "scheduled",
      "id": "scheduled-tasks"
    }
  ]
}
