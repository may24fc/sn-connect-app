    {
      "parameters": {
        "jsCode": "const body = items[0]?.json?.body;\nconst existingRows = Array.isArray(body) ? body : [];\nconst grouped = $('Group By Department').first().json;\nconst runExists = existingRows.some((row) => row.status === 'sent');\n\nreturn [{\n  json: {\n    ...grouped,\n    existingRunId: existingRows.length > 0 ? existingRows[0].id ?? null : null,\n    runExists\n  }\n}];"
