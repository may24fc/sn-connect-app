    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-5.4-mini\",\n  \"max_completion_tokens\": 1500,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You transform raw intern EOD reports into an ultra-brief executive digest for company owners sent via Telegram.\\n\\nSTRICT RULES:\\n1. COMPRESSION: Condense each intern into ONE short sentence focusing purely on business outcome/value. Combine multiple tasks if needed.\\n2. SCANNABILITY: Strip ALL redundant stats (hours, log counts, attachments). Leadership only cares about momentum and roadblocks.\\n3. STRUCTURE: Group strictly by Department. Optimize vertical spacing for narrow mobile screens.\\n4. NO JARGON: Translate technical language into plain business English.\\n\\nOutput ONLY valid Telegram HTML. Supported tags: <b>, <i>. No markdown, no asterisks.\\n\\nUse this EXACT structure:\\n\\n📱 <b>Daily EOD Digest</b> | [date]\\n━━━━━━━━━━━━━━━━━━\\n\\n🏢 <b>DEPARTMENT: [Department Name]</b>\\n• <b>[Intern Name]</b> - [Core Project Focus]\\n  ↳ <i>Progress:</i> [Single sentence on what was completed and its business benefit].\\n  ↳ <i>Blockers:</i> [None OR the critical roadblock in one sentence].\\n\\n[repeat • block for each intern in the department]\\n━━━━━━━━━━━━━━━━━━\\n[repeat 🏢 for each department]\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Transform this intern EOD dataset into an executive digest. Report date: ' + $json.reportDate + '\\n\\nDataset:\\n' + JSON.stringify($json.departments)) }}\n    }\n  ]\n}",
        "options": {
          "continueOnFail": true,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "summarize-with-ai",
      "name": "Summarize With AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2920,
        280
      ],
      "credentials": {
        "openAiApi": {
          "id": "iuc44Cp6qiyVISxA",
          "name": "SN Connect EOD Summarizer"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const grouped = $('Merge Run State').first().json;\nconst aiResponse = items[0]?.json;\nconst aiText = aiResponse?.choices?.[0]?.message?.content?.trim();\n\nconst div = '━━━━━━━━━━━━━━━━━━';\nconst lines = [\n  `📱 <b>Daily EOD Digest</b> | ${grouped.reportDate}`,\n  div,\n];\n\nfor (const dept of grouped.departments) {\n  lines.push('');\n  lines.push(`🏢 <b>DEPARTMENT: ${dept.department.toUpperCase()}</b>`);\n  for (const intern of dept.interns) {\n    const blockerText = (intern.blockers && intern.blockers.length > 0) ? intern.blockers.join('; ') : 'None';\n    const projectFocus = intern.projectEntries && intern.projectEntries.length > 0\n      ? intern.projectEntries.map(e => e.projectFocus).join(', ')\n      : 'General Operations';\n    lines.push(`• <b>${intern.name}</b> - ${projectFocus}`);\n    lines.push(`  ↳ <i>Progress:</i> ${intern.summary || 'Updates submitted for review.'}`);\n    lines.push(`  ↳ <i>Blockers:</i> ${blockerText}`);\n  }\n  lines.push('');\n  lines.push(div);\n}\n\nreturn [{\n  json: {\n    ...grouped,\n    telegramText: aiText || lines.join('\\n').trim(),\n    usedAiSummary: Boolean(aiText)\n  }\n}];"
      },
