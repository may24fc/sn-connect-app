    {
      "parameters": {
        "jsCode": "// fullResponse wraps body in an object → always 1 input item even when body is []\nconst rows = Array.isArray($json.body) ? $json.body : JSON.parse($json.body || '[]');\nreturn [{ json: { rows } }];"
      },
      "id": "collect-rows",
      "name": "Collect Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $json.rows;\nconst reportDate = $('Set Report Context').first().json.reportDate;\nconst destinationKey = $('Set Report Context').first().json.destinationKey;\nconst departments = new Map();\n\nfor (const row of rows) {\n  const departmentName = row.department || 'Unassigned';\n  if (!departments.has(departmentName)) {\n    departments.set(departmentName, {\n      department: departmentName,\n      totalHours: 0,\n      logCount: 0,\n      interns: [],\n      blockerCount: 0,\n      attachmentCount: 0,\n      projectEntries: []\n    });\n  }\n\n  const bucket = departments.get(departmentName);\n  const blockers = Array.isArray(row.blockers) ? row.blockers : [];\n  const attachments = Array.isArray(row.attachments) ? row.attachments : [];\n  const projectEntries = Array.isArray(row.project_entries) ? row.project_entries : [];\n\n  bucket.totalHours += Number(row.hours_worked || 0);\n  bucket.logCount += 1;\n  bucket.blockerCount += blockers.length;\n  bucket.attachmentCount += attachments.length;\n  bucket.projectEntries.push(...projectEntries);\n  bucket.interns.push({\n    name: row.intern_name,\n    hoursWorked: row.hours_worked,\n    blockers,\n    nextSteps: Array.isArray(row.next_steps) ? row.next_steps : [],\n    attachments: attachments.map((attachment) => attachment.fileName || 'Attachment'),\n    summary: row.tasks_completed_summary,\n    projectEntries: projectEntries,\n    adminDetailPath: row.admin_detail_path\n  });\n}\n\nreturn [{\n  json: {\n    reportDate,\n    destinationKey,\n    totalLogs: rows.length,\n    totalDepartments: departments.size,\n    departments: Array.from(departments.values()).sort((left, right) => left.department.localeCompare(right.department))\n  }\n}];"
      },
