{
  "name": "intern-eod-telegram-department-digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 1 * * 1-6"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily Trigger (09:00 PHT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 280]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "reportDate", "type": "string", "value": "={{ $now.setZone('Asia/Manila').minus({ days: 1 }).toFormat('yyyy-MM-dd') }}" },
            { "id": "a2", "name": "destinationKey", "type": "string", "value": "department-boss-digest" }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "set-report-context",
      "name": "Set Report Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 280]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zihdtxpvugdphieujhzk.supabase.co/rest/v1/rpc/get_intern_eod_digest_source",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppaGR0eHB2dWdkcGhpZXVqaHprIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2OTA2MDIyMiwiZXhwIjoyMDg0NjM2MjIyfQ.RIIu_RQO3OpRDLxMvHLGiYvHEIoPKXEjCa8tqu5IbBM" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "target_date", "value": "={{ $json.reportDate }}" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "id": "fetch-digest-rows",
      "name": "Fetch Digest Rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 280],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oiiTiTwKwkzLjGEc",
          "name": "[Dev] SN Connect Supabase REST"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// fullResponse wraps body in an object \u2192 always 1 input item even when body is []\nconst rows = Array.isArray($json.body) ? $json.body : JSON.parse($json.body || '[]');\nreturn [{ json: { rows } }];"
      },
      "id": "collect-rows",
      "name": "Collect Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 280]
    },
    {
      "parameters": {
        "jsCode": "const rows = $json.rows;\nconst reportDate = $('Set Report Context').first().json.reportDate;\nconst destinationKey = $('Set Report Context').first().json.destinationKey;\nconst departments = new Map();\n\nfor (const row of rows) {\n  const departmentName = row.department || 'Unassigned';\n  if (!departments.has(departmentName)) {\n    departments.set(departmentName, {\n      department: departmentName,\n      totalHours: 0,\n      logCount: 0,\n      interns: [],\n      blockerCount: 0,\n      attachmentCount: 0,\n      projectEntries: []\n    });\n  }\n\n  const bucket = departments.get(departmentName);\n  const blockers = Array.isArray(row.blockers) ? row.blockers : [];\n  const attachments = Array.isArray(row.attachments) ? row.attachments : [];\n  const projectEntries = Array.isArray(row.project_entries) ? row.project_entries : [];\n\n  bucket.totalHours += Number(row.hours_worked || 0);\n  bucket.logCount += 1;\n  bucket.blockerCount += blockers.length;\n  bucket.attachmentCount += attachments.length;\n  bucket.projectEntries.push(...projectEntries);\n  bucket.interns.push({\n    name: row.intern_name,\n    hoursWorked: row.hours_worked,\n    blockers,\n    nextSteps: Array.isArray(row.next_steps) ? row.next_steps : [],\n    attachments: attachments.map((attachment) => attachment.fileName || 'Attachment'),\n    summary: row.tasks_completed_summary,\n    adminDetailPath: row.admin_detail_path\n  });\n}\n\nreturn [{\n  json: {\n    reportDate,\n    destinationKey,\n    totalLogs: rows.length,\n    totalDepartments: departments.size,\n    departments: Array.from(departments.values()).sort((left, right) => left.department.localeCompare(right.department))\n  }\n}];"
      },
      "id": "group-by-department",
      "name": "Group By Department",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 280]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-total-logs",
              "leftValue": "={{ $json.totalLogs }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt", "name": "filter.operator.gt", "rightType": "any" }
            }
          ],
          "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }
        }
      },
      "id": "has-data",
      "name": "Has Prior-Day Logs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1380, 280]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://zihdtxpvugdphieujhzk.supabase.co/rest/v1/intern_eod_digest_runs?select=id,status&report_date=eq.' + $json.reportDate + '&channel=eq.telegram&destination_key=eq.' + $json.destinationKey + '&deleted_at=is.null' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppaGR0eHB2dWdkcGhpZXVqaHprIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2OTA2MDIyMiwiZXhwIjoyMDg0NjM2MjIyfQ.RIIu_RQO3OpRDLxMvHLGiYvHEIoPKXEjCa8tqu5IbBM" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "id": "check-existing-run",
      "name": "Check Existing Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oiiTiTwKwkzLjGEc",
          "name": "[Dev] SN Connect Supabase REST"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = items[0]?.json?.body;\nconst existingRows = Array.isArray(body) ? body : [];\nconst grouped = $('Group By Department').first().json;\nconst runExists = existingRows.some((row) => row.status === 'sent');\n\nreturn [{\n  json: {\n    ...grouped,\n    existingRunId: existingRows.length > 0 ? existingRows[0].id ?? null : null,\n    runExists\n  }\n}];"
      },
      "id": "merge-run-state",
      "name": "Merge Run State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 180]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-run-exists",
              "leftValue": "={{ $json.runExists }}",
              "rightValue": "",
              "operator": { "name": "filter.operator.true", "operation": "true", "singleValue": true, "type": "boolean" }
            }
          ],
          "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }
        }
      },
      "id": "already-sent",
      "name": "Already Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2040, 180]
    },
    {
      "parameters": {},
      "id": "skip-already-sent",
      "name": "Skip Already Sent",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2260, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"max_tokens\": 2000,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are formatting intern end-of-day (EOD) reports into a Telegram digest message for a boss. Rules: (1) Add a header line: 📋 EOD Digest — [date]. (2) Group by department with a 🏢 emoji heading. (3) List EACH INTERN INDIVIDUALLY by full name with 👤 emoji — never merge or aggregate multiple interns into a group summary. (4) For each intern: name and hours worked on the same line, then their specific accomplishments in 1-2 sentences, then any blockers prefixed with 🚧 Blocker:, then next steps prefixed with ✅ Next:, then 📎 N attachment(s) if any. (5) Footer: total intern count and department count. (6) Plain text only — no asterisks, no HTML, no markdown. Do not invent facts not present in the dataset.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Format this intern EOD dataset as a Telegram digest. Report date: ' + $json.reportDate + '\\n\\nIMPORTANT: List EACH intern individually by name under their department heading. Do not merge or combine interns together.\\n\\nDataset:\\n' + JSON.stringify($json.departments)) }}\n    }\n  ]\n}",
        "options": {
          "continueOnFail": true,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "summarize-with-ai",
      "name": "Summarize With AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2260, 280],
      "credentials": {
        "openAiApi": {
          "id": "iuc44Cp6qiyVISxA",
          "name": "SN Connect EOD Summarizer"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const grouped = $('Merge Run State').first().json;\nconst aiResponse = items[0]?.json;\nconst aiText = aiResponse?.choices?.[0]?.message?.content?.trim();\n\nconst lines = [`📋 EOD Digest — ${grouped.reportDate}`, ''];\n\nfor (const dept of grouped.departments) {\n  lines.push(`🏢 ${dept.department} (${dept.logCount} intern${dept.logCount !== 1 ? 's' : ''})`);
  lines.push('');\n  for (const intern of dept.interns) {\n    lines.push(`👤 ${intern.name} (${Number(intern.hoursWorked || 0).toFixed(1)}h)`);\n    if (intern.summary) lines.push(intern.summary);\n    if (intern.blockers && intern.blockers.length > 0) {\n      lines.push(`🚧 Blocker: ${intern.blockers.join('; ')}`);\n    }\n    if (intern.nextSteps && intern.nextSteps.length > 0) {\n      lines.push(`✅ Next: ${intern.nextSteps.join('; ')}`);\n    }\n    if (intern.attachments && intern.attachments.length > 0) {\n      lines.push(`📎 ${intern.attachments.length} attachment(s)`);\n    }\n    lines.push('');\n  }\n}\n\nlines.push(`${grouped.totalLogs} log(s) across ${grouped.totalDepartments} department(s)`);\n\nreturn [{\n  json: {\n    ...grouped,\n    telegramText: aiText || lines.join('\\n').trim(),\n    usedAiSummary: Boolean(aiText)\n  }\n}];"
      },
      "id": "build-telegram-message",
      "name": "Build Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2480, 280]
    },
    {
      "parameters": {
        "chatId": "6708968435",
        "text": "={{ $json.telegramText }}",
        "resource": "message",
        "operation": "sendMessage",
        "additionalFields": {}
      },
      "id": "send-telegram",
      "name": "Send Telegram Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2700, 280],
      "webhookId": "414102d0-e5f1-40be-9275-1b4d1ae8b43d",
      "credentials": {
        "telegramApi": {
          "id": "br7oYixc6HEh3DQc",
          "name": "SN Connect Notifications"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zihdtxpvugdphieujhzk.supabase.co/rest/v1/intern_eod_digest_runs?on_conflict=report_date,channel,destination_key",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppaGR0eHB2dWdkcGhpZXVqaHprIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2OTA2MDIyMiwiZXhwIjoyMDg0NjM2MjIyfQ.RIIu_RQO3OpRDLxMvHLGiYvHEIoPKXEjCa8tqu5IbBM" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=representation" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"report_date\": \"{{ $('Build Telegram Message').first().json.reportDate }}\",\n  \"channel\": \"telegram\",\n  \"destination_key\": \"{{ $('Build Telegram Message').first().json.destinationKey }}\",\n  \"workflow_execution_id\": \"{{ $execution.id }}\",\n  \"status\": \"{{ $json.result.message_id ? 'sent' : 'failed' }}\",\n  \"sent_at\": {{ $json.result.message_id ? ('\"' + $now.toISO() + '\"') : 'null' }},\n  \"error_message\": {{ $json.result.message_id ? 'null' : '\"Telegram delivery failed\"' }},\n  \"summary_json\": {\n    \"totalLogs\": {{ $('Build Telegram Message').first().json.totalLogs }},\n    \"totalDepartments\": {{ $('Build Telegram Message').first().json.totalDepartments }},\n    \"usedAiSummary\": {{ $('Build Telegram Message').first().json.usedAiSummary }},\n    \"telegramMessageId\": {{ $json.result.message_id ?? 'null' }}\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "record-run",
      "name": "Record Digest Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2920, 280],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oiiTiTwKwkzLjGEc",
          "name": "[Dev] SN Connect Supabase REST"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zihdtxpvugdphieujhzk.supabase.co/rest/v1/intern_eod_digest_runs?on_conflict=report_date,channel,destination_key",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppaGR0eHB2dWdkcGhpZXVqaHprIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2OTA2MDIyMiwiZXhwIjoyMDg0NjM2MjIyfQ.RIIu_RQO3OpRDLxMvHLGiYvHEIoPKXEjCa8tqu5IbBM" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=representation" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"report_date\": \"{{ $json.reportDate }}\",\n  \"channel\": \"telegram\",\n  \"destination_key\": \"{{ $json.destinationKey }}\",\n  \"workflow_execution_id\": \"{{ $execution.id }}\",\n  \"status\": \"skipped\",\n  \"summary_json\": {\n    \"reason\": \"no-prior-day-submitted-logs\",\n    \"totalLogs\": {{ $json.totalLogs }},\n    \"totalDepartments\": {{ $json.totalDepartments }}\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "record-skip-no-data",
      "name": "Record Skip (No Data)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 420],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oiiTiTwKwkzLjGEc",
          "name": "[Dev] SN Connect Supabase REST"
        }
      }
    },
    {
      "parameters": {},
      "id": "finish-no-data",
      "name": "No Prior-Day Logs",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1820, 420]
    }
  ],
  "connections": {
    "Daily Trigger (09:00 PHT)": {
      "main": [[{ "node": "Set Report Context", "type": "main", "index": 0 }]]
    },
