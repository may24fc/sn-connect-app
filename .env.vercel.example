# Vercel Environment Variables Template
# Copy this file and fill in your actual values

# ============================================
# PUBLIC VARIABLES (Client-side accessible)
# ============================================
# These are safe to expose and will be bundled into the client-side JavaScript

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# SECRET VARIABLES (Server-side only)
# ============================================
# These must NEVER be exposed to the client

# Supabase Service Role Key (Admin access - KEEP SECRET!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic API Key for Claude AI (Must start with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-api03-...

# JWT Secret (Minimum 32 characters, cryptographically secure random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-random-string-min-32-chars

# n8n Workflow Automation
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/hr-portal
N8N_API_KEY=your-n8n-api-key

# ============================================
# VERCEL-SPECIFIC (For GitHub Actions)
# ============================================
# These are automatically set by Vercel CLI when you run `vercel link`
# Extract from .vercel/project.json after linking

VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxx
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL: Additional Production Settings
# ============================================

# Node Environment (auto-set by Vercel)
# NODE_ENV=production

# Vercel System Environment Variables (auto-set)
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app
# VERCEL_REGION=iad1
