hor": null, "contributor": null}, {"id": "www_readme_atsprocessing", "label": "ATS Resume Processing (Inngest event)", "file_type": "rationale", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event is non-blocking so a failure of ATS processing does not stop the application submission flow; only sent when INNGEST_EVENT_KEY is configured."}, {"id": "www_readme_dbmigrate", "label": "pnpm db:migrate (Remote Migration Caution)", "file_type": "rationale", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pnpm db:migrate pushes to whatever Supabase project the CLI is linked to, which can be staging or production; this monorepo shares one Supabase schema across apps/www, apps/web, and backend workflows, so casual use during www setup is discouraged."}, {"id": "www_readme_localsupabasestack", "label": "Local Supabase Stack (non-default ports)", "file_type": "concept", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "www_readme_remotemigrationworkflow", "label": "Verified Remote Migration History Repair", "file_type": "rationale", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repo has a verified precedent: remote migration history needed repair on a staging project, fixed by linking the CLI to the remote project and running an intentional remote db push."}, {"id": "www_readme_mentalmodel", "label": "Three-Layer Mental Model (presentation/integration/operational)", "file_type": "rationale", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/www is modeled as presentation (src/app, src/components), integration (src/lib, src/app/api), and operational (env vars, Supabase, Resend, Vercel) layers; most regressions happen at the boundaries between layers rather than in isolated UI markup. Route files, API routes, env vars, and hidden-section docs are described as connecting page ownership, Supabase/storage/audit/email/ATS behavior, and release-safe rollout of unfinished features."}, {"id": "www_readme_seniorreview", "label": "Senior Review Rationale (redundancy/abstraction/predictability/performance)", "file_type": "rationale", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This README is intentionally the single entry point since docs/README.md already advertised it; it stays at app-ownership level instead of duplicating the testing guide; it follows the monorepo's actual root-scripts/root-Vercel/app-local-env structure; and the biggest deployment risk is content/integration drift rather than rendering performance."}, {"id": "www_readme_docsdriftrisk", "label": "Docs Drift Risk", "file_type": "rationale", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "docs/README.md previously referenced apps/www/README.md but the file did not exist; this document was written to be the source-of-truth entry point going forward."}, {"id": "www_readme_placeholdercontentrisk", "label": "Placeholder-Content Risk", "file_type": "rationale", "source_file": "www/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several parts of the public site still depend on src/data/placeholder.ts or mixed placeholder plus live data, especially the hidden sections."}, {"id": "www_readme_hiddensectiondoc", "label": "hidden-sections-2026-03-30.md", "file_type": "document", "source_file": "www/README.md", "source